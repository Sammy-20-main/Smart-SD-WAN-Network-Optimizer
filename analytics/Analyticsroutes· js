/**
 * MODULE 4 : ANALYTICS & REPORTING MODULE — routes
 * Smart SD-WAN Network Optimizer
 */

const express = require("express");
const PDFDocument = require("pdfkit");
const {
  getSimulationResults,
  computeSummary,
  networkHealthSnapshot,
} = require("./analyticsService");

const router = express.Router();

// --------------------------------------------------------------------------
// Performance Dashboard
// --------------------------------------------------------------------------

router.get("/dashboard", (req, res) => {
  const records = getSimulationResults();
  const summary = computeSummary(records);
  res.json({ summary, recentRuns: records.slice(0, 5) });
});

// Chart.js feed for the dashboard — call this after every new Module 3 run
// instead of reloading the whole page.
router.get("/dashboard/chart-data", (req, res) => {
  const records = [...getSimulationResults()].sort((a, b) => a.timestamp - b.timestamp);
  res.json({
    labels: records.map((r) =>
      new Date(r.timestamp).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })
    ),
    latencyMs: records.map((r) => r.latencyMs),
    cost: records.map((r) => r.cost),
    slaThresholdMs: records.length ? records[0].slaThresholdMs : 0,
    summary: computeSummary(records),
  });
});

// --------------------------------------------------------------------------
// Latency Report
// --------------------------------------------------------------------------

router.get("/latency-report", (req, res) => {
  const records = getSimulationResults();
  res.json({ summary: computeSummary(records), records });
});

// --------------------------------------------------------------------------
// Cost Analysis
// --------------------------------------------------------------------------

router.get("/cost-analysis", (req, res) => {
  const records = getSimulationResults();
  res.json({ summary: computeSummary(records), records });
});

// --------------------------------------------------------------------------
// Network Health Monitoring
// --------------------------------------------------------------------------

router.get("/network-health", (req, res) => {
  const records = getSimulationResults();
  res.json({ health: networkHealthSnapshot(records) });
});

// --------------------------------------------------------------------------
// Export: CSV
// --------------------------------------------------------------------------

router.get("/export/csv", (req, res) => {
  const records = getSimulationResults();
  const headers = [
    "runId", "timestamp", "source", "destination", "relayNodes",
    "relayCount", "latencyMs", "slaThresholdMs", "slaMet",
    "cost", "bandwidthMbps", "packetLossPct",
  ];

  const escape = (val) => {
    const s = String(val);
    return /[",\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
  };

  const rows = records.map((r) =>
    headers
      .map((h) => {
        if (h === "relayNodes") return escape(r.relayNodes.join("-"));
        if (h === "timestamp") return escape(new Date(r.timestamp).toISOString());
        return escape(r[h]);
      })
      .join(",")
  );

  const csv = [headers.join(","), ...rows].join("\n");

  res.setHeader("Content-Type", "text/csv");
  res.setHeader("Content-Disposition", "attachment; filename=network_report.csv");
  res.send(csv);
});

// --------------------------------------------------------------------------
// Export: PDF
// --------------------------------------------------------------------------

router.get("/export/pdf", (req, res) => {
  const records = getSimulationResults();
  const summary = computeSummary(records);

  const doc = new PDFDocument({ margin: 40, size: "A4" });
  res.setHeader("Content-Type", "application/pdf");
  res.setHeader("Content-Disposition", "attachment; filename=network_report.pdf");
  doc.pipe(res);

  doc.fontSize(18).text("Smart SD-WAN Network Optimizer — Performance Report", { align: "left" });
  doc.moveDown(0.3);
  doc.fontSize(10).fillColor("#555").text(`Generated ${new Date().toISOString()}`);
  doc.moveDown(1);

  doc.fillColor("#000").fontSize(13).text("Summary", { underline: true });
  doc.moveDown(0.3);
  doc.fontSize(10).text(`Total Runs: ${summary.totalRuns}`);
  doc.text(`Average Latency: ${summary.avgLatency} ms`);
  doc.text(`Average Cost: $${summary.avgCost}`);
  doc.text(`SLA Compliance: ${summary.slaCompliancePct}%`);
  doc.text(`Average Relay Count: ${summary.avgRelayCount}`);
  doc.moveDown(1);

  doc.fontSize(13).text("Run Detail", { underline: true });
  doc.moveDown(0.3);

  const colX = [40, 100, 170, 280, 340, 400];
  const headerY = doc.y;
  doc.fontSize(9).fillColor("#fff");
  doc.rect(40, headerY, 500, 16).fill("#374151");
  doc.fillColor("#fff");
  doc.text("Run ID", colX[0], headerY + 4, { width: 55 });
  doc.text("Src→Dst", colX[1], headerY + 4, { width: 65 });
  doc.text("Relays", colX[2], headerY + 4, { width: 100 });
  doc.text("Latency", colX[3], headerY + 4, { width: 55 });
  doc.text("SLA", colX[4], headerY + 4, { width: 50 });
  doc.text("Cost", colX[5], headerY + 4, { width: 50 });

  let y = headerY + 16;
  doc.fillColor("#000").fontSize(8);
  records.forEach((r, i) => {
    if (y > 760) {
      doc.addPage();
      y = 40;
    }
    if (i % 2 === 0) doc.rect(40, y, 500, 14).fill("#f3f4f6").fillColor("#000");
    doc.text(r.runId, colX[0], y + 3, { width: 55 });
    doc.text(`${r.source}→${r.destination}`, colX[1], y + 3, { width: 65 });
    doc.text(r.relayNodes.join("-"), colX[2], y + 3, { width: 100 });
    doc.text(`${r.latencyMs} ms`, colX[3], y + 3, { width: 55 });
    doc.text(r.slaMet ? "Met" : "Breached", colX[4], y + 3, { width: 50 });
    doc.text(`$${r.cost}`, colX[5], y + 3, { width: 50 });
    y += 14;
  });

  doc.end();
});

module.exports = router;